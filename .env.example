# =============================================================================
# LoyaCareCRM - Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in the values for your environment
# cp .env.example .env
# =============================================================================

# =============================================================================
# General application settings
# =============================================================================
# Server IP address or domain (without http://)
DOMAIN=217.154.173.36

# Environment (production, staging, development)
NODE_ENV=production

# Application version
NEXT_PUBLIC_APP_VERSION=production

# =============================================================================
# Frontend settings (Next.js)
# =============================================================================
# Port the Frontend listens on
FRONTEND_PORT=3000

# API URL for client requests (relative path via Nginx)
NEXT_PUBLIC_API_URL=/api

# Backend API URL (for server-side requests)
NEXT_PUBLIC_BACKEND_API_URL=http://217.154.173.36/api

# =============================================================================
# Backend settings (Express)
# =============================================================================
# Port the Backend listens on
BACKEND_PORT=4000

# Logging level (error, warn, info, debug)
LOG_LEVEL=info

# CORS origin (frontend address)
CORS_ORIGIN=http://217.154.173.36

# =============================================================================
# PostgreSQL database
# =============================================================================
# Database name
POSTGRES_DB=crm

# PostgreSQL user
POSTGRES_USER=crm

# PostgreSQL password
# IMPORTANT: Generate a strong password!
# Example: openssl rand -base64 16
POSTGRES_PASSWORD=crm2024secure

# =============================================================================
# Security
# =============================================================================
# JWT Secret key for signing tokens
# IMPORTANT: Generate a unique secret!
# Example: openssl rand -base64 32
JWT_SECRET=dGhpc2lzYXNlY3JldGp3dHNlY3JldGtleQ==

# =============================================================================
# Docker Images
# =============================================================================
# Frontend Docker image
FRONTEND_IMAGE=crm-frontend:latest

# Backend Docker image
BACKEND_IMAGE=crm-backend:latest

# =============================================================================
# Service ports
# =============================================================================
# Nginx port (external HTTP)
NGINX_PORT=80

# =============================================================================
# Additional settings (optional)
# =============================================================================
# For use with Docker Registry (GitHub Container Registry)
# FRONTEND_IMAGE=ghcr.io/sergeylc/crm/frontend:latest
# BACKEND_IMAGE=ghcr.io/sergeylc/crm/backend:latest

# =============================================================================
# Generating secure values
# =============================================================================
# Use the following commands to generate secure values:
#
# JWT Secret:
#   openssl rand -base64 32
#
# Database Password:
#   openssl rand -base64 16
#
# Example of full .env file generation:
#   echo "JWT_SECRET=$(openssl rand -base64 32)" >> .env
#   echo "POSTGRES_PASSWORD=$(openssl rand -base64 16)" >> .env
