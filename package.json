{
  "name": "loya-crm-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "crm - CRM system for managing leads, deals, and customer relationships",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "test:ci": "pnpm -r --workspace-concurrency=1 run test",
    "test": "pnpm -r run test",
    "build": "pnpm -r run build",
    "dev": "pnpm -r --parallel run dev",
    "lint": "pnpm -r run lint",
    "type-check": "pnpm -r run type-check",
    "check:yaml": "node scripts/check-yaml.mjs",
    "deploy:release": "node scripts/deploy.js"
  },
  "devDependencies": {
    "yaml": "2.8.1"
  },
  "keywords": [
    "crm",
    "leads",
    "deals",
    "customers"
  ],
  "author": "SergeyLC",
  "license": "MIT"
}
