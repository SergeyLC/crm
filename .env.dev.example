# Database (dev defaults - change passwords for production!)
POSTGRES_DB=crm
POSTGRES_USER=crm
POSTGRES_PASSWORD=your_secure_password_here

# Backend (dev settings)
DATABASE_URL=postgresql://crm:your_secure_password_here@postgres:5432/crm
JWT_SECRET=your_dev_jwt_secret_key_here
PORT=4003
NODE_ENV=development

# Frontend (dev settings)
NEXT_PUBLIC_API_URL=http://localhost:4003/api
NEXT_PUBLIC_BACKEND_API_URL=http://crm-backend-dev:4003/api
NEXT_PUBLIC_APP_VERSION=docker-dev