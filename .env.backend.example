# Database (External PostgreSQL - configure for your production database)
DATABASE_URL="postgresql://username:password@host:5432/database_name"

# Backend Configuration
PORT=4002
JWT_SECRET=your_super_secret_jwt_key_here
CORS_ORIGIN=https://your-domain.com
NODE_ENV=production
PRISMA_LOG_LEVEL=warn
LOG_LEVEL=info

# Session cookie Secure flag: true|false. Leave unset to follow X-Forwarded-Proto
# (HTTP stage :8080/:8081 must NOT force Secure or browsers drop crm_session).
# COOKIE_SECURE=false

# Optional: Additional security settings
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX_REQUESTS=100