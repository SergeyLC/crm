# Frontend Test Environment

# Environment
NODE_ENV=test

# Application URLs — browser same-origin /api (Next BFF); do not point at :4001
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_BACKEND_API_URL=http://localhost:4001/api

# Server
PORT=3001
HOST=localhost

# Features
NEXT_PUBLIC_ENABLE_DEVTOOLS=false
NEXT_PUBLIC_ENABLE_DEBUG=true

# Test configuration
PLAYWRIGHT_BASE_URL="http://localhost:3001"
