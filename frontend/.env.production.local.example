# Frontend Production Secrets
# Copy to .env.production.local and fill in actual values

# Application URLs (REQUIRED) — browser uses same-origin /api for crm_session cookie
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_BACKEND_API_URL=https://api.your-production-domain.com/api

# Analytics (Optional)
# NEXT_PUBLIC_GA_ID="UA-XXXXXXXXX-X"
# NEXT_PUBLIC_SENTRY_DSN="https://xxx@sentry.io/xxx"
